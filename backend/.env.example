# ==============================================================================
# Zenve Zippy - Backend Environment Configuration Example
# ==============================================================================

# Database Server Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pet_management

# Optional complete connection URL:
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/pet_management

# SMS Gateway Configuration
PROVIDER=apitxt
APITXT_AUTHKEY=
SMS_API_KEY=
APITXT_CHANNEL=sms

